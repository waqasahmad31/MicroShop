# MicroShop LOCAL DEVELOPMENT ONLY. These public example passwords are not production-safe.
# Copy to ignored .env and replace all six passwords with distinct local values.
# scripts/New-DevelopmentEnvironment.ps1 generates random values without printing them.
# Compose reads .env; dotnet CLI does not automatically import it.
POSTGRES_PORT=5432
POSTGRES_ADMIN_PASSWORD=dev-only-replace-admin-password
IDENTITY_DB_PASSWORD=dev-only-replace-identity-password
CATALOG_DB_PASSWORD=dev-only-replace-catalog-password
INVENTORY_DB_PASSWORD=dev-only-replace-inventory-password
ORDERING_DB_PASSWORD=dev-only-replace-ordering-password

RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=microshop_dev
RABBITMQ_PASSWORD=dev-only-replace-rabbitmq-password
RABBITMQ_VHOST=microshop

# Fixed PostgreSQL login/database pairs:
# identity_app / identity_db; catalog_app / catalog_db
# inventory_app / inventory_db; ordering_app / ordering_db
# Bootstrap administration only: microshop_admin / postgres
# Port conflict? Change POSTGRES_PORT in .env, for example to 5433.
